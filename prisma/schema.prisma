generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum PlanType {
  FREE
  DIRECT
}

enum OrderStatus {
  PENDING
  IN_PROGRESS
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum InventoryMovementType {
  CREATED
  ADJUSTMENT
  ORDER_DEDUCTION
}

enum QuoteStatus {
  PENDING
  QUOTED
  ACCEPTED
  REJECTED
}

model Product {
  id                 String              @id @default(cuid())
  slug               String              @unique
  sku                String?             @unique
  supplier           String             @default("")
  originCountry      String             @default("")
  category           String
  name               String
  price              Int
  previousPrice      Int
  stock              Int                 @default(0)
  minimumStock       Int                 @default(3)
  image              String
  galleryImages      String[]            @default([])
  video              String?
  availability       String
  shortDescription   String             @default("")
  description        String
  application        String?
  marketFocus        String?
  compatibility      String[]            @default([])
  technicalSpecs     Json?
  featured           Boolean             @default(false)
  active             Boolean             @default(true)
  providerId         String?
  provider           User?               @relation("ProductProvider", fields: [providerId], references: [id], onDelete: SetNull)
  inventoryMovements InventoryMovement[]
  quotes             Quote[]
  conversations      Conversation[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  company      String?
  phone        String?
  role         UserRole @default(CUSTOMER)
  plan         PlanType @default(FREE)
  passwordHash String
  logoUrl      String?
  proveedorProLanding ProveedorProLanding?
  orders       Order[]
  quotes       Quote[]
  conversations       Conversation[]  @relation("ConversationClient")
  products     Product[]              @relation("ProductProvider")
  sentMessages        ChatMessage[]   @relation("ChatMessageSender")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}


model Order {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         OrderStatus   @default(PENDING)
  paymentStatus  PaymentStatus @default(PENDING)
  customerName   String
  customerEmail  String
  customerPhone  String?
  company        String?
  trackingNumber String?
  carrier        String?
  notes          String?
  subtotal       Int
  totalItems     Int
  items          OrderItem[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  name      String
  image     String
  unitPrice Int
  quantity  Int
  lineTotal Int
  createdAt DateTime @default(now())
}

model Quote {
  id                 String      @id @default(cuid())
  productId          String
  clientId           String
  quantity           Int
  destinationCountry String
  message            String?
  status             QuoteStatus @default(PENDING)
  providerPrice      Int?
  providerNote       String?
  product            Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  client             User        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
}

model Conversation {
  id        String        @id @default(cuid())
  productId String
  clientId  String
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  client    User          @relation("ConversationClient", fields: [clientId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([productId, clientId])
}

model ChatMessage {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
}

model InventoryMovement {
  id         String                @id @default(cuid())
  productId  String
  product    Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  type       InventoryMovementType
  quantity   Int
  stockAfter Int
  note       String?
  createdAt  DateTime              @default(now())
}

model GameScore {
  id        String   @id @default(cuid())
  name      String
  score     Int
  createdAt DateTime @default(now())
}

model ProveedorProLanding {
  id        String   @id @default(cuid())
  slug      String   @unique
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  store     Json
  products  Json
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// slot: "popup" (modal al navegar) | "sidebar" (banner lateral del catálogo)
model Banner {
  id        String   @id @default(cuid())
  slot      String
  imageUrl  String
  alt       String
  linkUrl   String?
  width     Int      @default(300)
  height    Int      @default(600)
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slot, active])
}
